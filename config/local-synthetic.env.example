# Template only; adapt paths to a new isolated test data directory.
ULTRARAG_DATA_DIR=<absolute-test-data-directory>
DATABASE_URL=sqlite:///<absolute-test-database-path>
ULTRARAG_HOST=127.0.0.1
ULTRARAG_PORT=5173
DEMO_SEED_ENABLED=false
HARNESS_CONTROL_AUTH_PROVIDER=
DEMO_MODEL_API_KEY=
EXTERNAL_TASK_CALLBACK_BASE_URL=
CODEX_A2A_ENABLED=false
# Fresh installs must persist generated installation material.
# Upgrades must retain the original effective APP_SECRET and installation seed.
# Missing provider/source approvals deny model egress; no bypass flag.
